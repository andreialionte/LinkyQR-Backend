{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost,5432;Database=LinkyDB;Username=postgres;Password=postgres;",
        "Valkey": "127.0.0.1:6379"
    },

    "AllowedHosts": "*",

    "ReverseProxy": {
        "Routers": {
            "default": {
                "ClusterId": "backend",
                "Match": { "Path": "{**catch-all}" }
            }
        },
        "Clusters": {
            "backend": { // https://deepwiki.com/dotnet/yarp/6.1-configuration-based-setup
                "HttpClient": {
                    "SslProtocols": [ "Tls13" ],
                    "DangerousAcceptAnyServerCertificate": true,
                    "EnableMultipleHttp2Connections": true,
                    "WebProxy": {
                        "Address": "http://127.0.0.1",
                        "BypassOnLocal": true,
                        "UseDefaultCredentials": false
                    }
                },
                "HttpRequest": {
                    "Version": "3",
                    "VersionPolicy": "RequestVersionExact",
                    "ActivityTimeout": "00:01:00" // e.g. 1 minute, adjust as needed
                },
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:5000"
                    }
                }
            }
        }
    }
}
