{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}",
    "Valkey": "${REDIS_CONNECTION_STRING}"
  },
  "Mqtt": {
    "Host": "${MQTT_HOST}",
    "Port": "${MQTT_PORT}",
    "ClientId": "${MQTT_CLIENT_ID}",
    "Username": "${MQTT_USERNAME}",
    "Password": "${MQTT_PASSWORD}",
    "UseTls": "${MQTT_USE_TLS}",
    "KeepAliveIntervalSeconds": "${MQTT_KEEPALIVE_SECONDS}",
    "ReconnectDelaySeconds": "${MQTT_RECONNECT_SECONDS}"
  },
    "AllowedHosts": "*"
}
