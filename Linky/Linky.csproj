<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- 🚀 Max Core Performance & Dynamic JIT Tuning -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>

    <!-- 🧠 Memory Scaling (DATAS Mode) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>

    <!-- ⚡ Advanced .NET 10 Low-Latency Extensions -->
    <Thread_UseAllCpuGroups>true</Thread_UseAllCpuGroups>
    <GCCpuGroup>true</GCCpuGroup>
    <UseVectorExtensions>true</UseVectorExtensions>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>


    <!-- 🛠️ Production Build Optimization -->
    <Deterministic>true</Deterministic>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>

    <!-- 📦 Framework-Dependent Linux Container Deployment -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>

    <!-- Maximize AVX10.2 / SIMD Hardware Vectorization -->
    <AVXComputeMode>Max</AVXComputeMode>
    <IncludeUnvctPaths>false</IncludeUnvctPaths>
    <!-- Drop Reflection Overhead on Modern Serializers -->
    <IlcGenerateMetadata>false</IlcGenerateMetadata>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <!-- ThreadPool Scaling & Lock Elision -->
    <ThreadPool_UnfairSemaphoreSpinCount>100</ThreadPool_UnfairSemaphoreSpinCount>

    <TailCallOptimization>true</TailCallOptimization>



    <!-- 🛡️ Basic Configuration -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1b8c3161-8da9-483b-9490-907dc4fc756c</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Job\**" />
    <Content Remove="Job\**" />
    <EmbeddedResource Remove="Job\**" />
    <None Remove="Job\**" />
  </ItemGroup>

