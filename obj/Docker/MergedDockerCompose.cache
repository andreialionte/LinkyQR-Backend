name: dockercompose14778261688183183522
services:
  dragonfly:
    command:
      - --logtostderr
      - --dir=/data
      - --proactor_threads=2
      - --cache_mode=true
      - --maxmemory=4GiB
    image: docker.dragonflydb.io/dragonflydb/dragonfly:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 6379
        published: "6379"
        protocol: tcp
    restart: unless-stopped
    ulimits:
      memlock: -1
    volumes:
      - type: volume
        source: dragonfly_data
        target: /data
        volume: {}
  linky:
    build:
      context: C:\Users\Andrei\source\repos\Linky
      dockerfile: Linky/Dockerfile
    depends_on:
      dragonfly:
        condition: service_started
        required: true
      nats:
        condition: service_started
        required: true
      postgres:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "5000"
      ConnectionStrings__DefaultConnection: Host=postgres;Port=5432;Database=LinkyDB;Username=postgres;Password=postgres
      ConnectionStrings__Nats: nats://nats:4222
      ConnectionStrings__Valkey: dragonfly:6379
    image: linky
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  nats:
    image: nats:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 4222
        published: "4222"
        protocol: tcp
      - mode: ingress
        target: 6222
        published: "6222"
        protocol: tcp
      - mode: ingress
        target: 8222
        published: "8222"
        protocol: tcp
    restart: unless-stopped
  postgres:
    environment:
      POSTGRES_DB: LinkyDB
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U postgres -d LinkyDB
      timeout: 5s
      interval: 10s
      retries: 5
    image: postgres:15
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose14778261688183183522_default
volumes:
  dragonfly_data:
    name: dockercompose14778261688183183522_dragonfly_data
  pgdata:
    name: dockercompose14778261688183183522_pgdata