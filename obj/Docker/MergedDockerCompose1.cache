name: dockercompose14778261688183183522
services:
  dragonfly:
    command:
      - --logtostderr
      - --dir=/data
      - --proactor_threads=2
      - --cache_mode=true
      - --maxmemory=4GiB
    image: docker.dragonflydb.io/dragonflydb/dragonfly:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 6379
        published: "6379"
        protocol: tcp
    restart: unless-stopped
    ulimits:
      memlock: -1
    volumes:
      - type: volume
        source: dragonfly_data
        target: /data
        volume: {}
  linky:
    build:
      context: C:\Users\Andrei\source\repos\Linky
      dockerfile: Linky/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: Linky
      target: base
    depends_on:
      dragonfly:
        condition: service_started
        required: true
      nats:
        condition: service_started
        required: true
      postgres:
        condition: service_healthy
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "5000"
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ConnectionStrings__DefaultConnection: Host=postgres;Port=5432;Database=LinkyDB;Username=postgres;Password=postgres
      ConnectionStrings__Nats: nats://nats:4222
      ConnectionStrings__Valkey: dragonfly:6379
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: linky:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net10.0/Linky.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\source\repos\Linky\Linky
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\source\repos\Linky
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Andrei\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /.nuget/fallbackpackages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net6.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
  nats:
    image: nats:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 4222
        published: "4222"
        protocol: tcp
      - mode: ingress
        target: 6222
        published: "6222"
        protocol: tcp
      - mode: ingress
        target: 8222
        published: "8222"
        protocol: tcp
    restart: unless-stopped
  postgres:
    environment:
      POSTGRES_DB: LinkyDB
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U postgres -d LinkyDB
      timeout: 5s
      interval: 10s
      retries: 5
    image: postgres:15
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose14778261688183183522_default
volumes:
  dragonfly_data:
    name: dockercompose14778261688183183522_dragonfly_data
  pgdata:
    name: dockercompose14778261688183183522_pgdata